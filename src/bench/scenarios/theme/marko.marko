<!-- Theme change, Marko 6: the accent is a tag variable at the top and every badge's class reads it, so a change
     updates those 2.000 class bindings. Compiled with the benchmark app's Marko build (tools/gen-bench.mjs →
     ../../apps/marko.gen.js); steps are flushed with run() (../marko.ts). -->
import { FIRST, badgeClass } from "./def.ts"
<let/accent=FIRST/>
<script>input.api.step = (a) => { accent = a }</script>
<div class="cards">
  <for|c| of=input.data by="id">
    <div class="card"><h3>${c.title}</h3><p>${c.text}</p><span class=badgeClass(accent)>#${c.id}</span></div>
  </for>
</div>
